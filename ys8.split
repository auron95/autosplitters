// selectProcess {
//     debug print(`{process.path() else "unavailable"}`)
//     return true
// }

onAttach {
    print(`Attached to {process.name()}`)
    let module: Module = await process.mainModule()

    print(`Module size is {module.size}`)
    if module.size == 0x0045A000 {
        build = Build.PrePatch
        debug print("PrePatch version")
        return
    }
    if module.size == 0x0074C000 {
        build = Build.PostPatch
        debug print("PostPatch version")
        return
    }

    await process.closed()
}

onStart {
    debug print("Timer started now!")
    completedSplits.clear()
}

isLoading {
    return current.loadingState == 1
}

split {
    // debug print(`{current.scene}`)
    if old.scene != current.scene {
        if !completedSplits.containsKey(current.scene) {
            completedSplits.insert(current.scene, true)
            return settings.enabled(`scene_{current.scene}`)
        }
    }
    let currentSceneBosses: [Boss] = match current.scene {
        123918 => [Boss.AvocadoCoast, Boss.Kiergaard],
        59671 => [Boss.Tentacle],
        21458 => [Boss.Byfteriza],
        8596 => [Boss.Serpentus],
        20630 => [Boss.Clareon],
        12671 => [Boss.Lombrigius],
        10951 => [Boss.Gargantula],
        11098 => [Boss.Magamandra],
        19461 => [Boss.Laspisus],
        55973 => [Boss.PirateRevenant],
        81490 => [Boss.AvocadoGendarme],
        57432 => [Boss.Giasburn],
        21372 => [Boss.LeErythros],
        17276 => [Boss.Exmetal],
        15403 => [Boss.Carveros],
        15513 => [Boss.DoxaGriel],
        17202 => [Boss.Basileus],
        9713 => [Boss.Coelacantos],
        72484 => [Boss.Oceanus],
        1883 => [Boss.Hydra],
        1734 => [Boss.Minos],
        1860 => [Boss.Nestor],
        1810 => [Boss.Ura],
        101491 => [Boss.LeKyanos],
        32265 => [Boss.Brachion],
        46953 => [Boss.Grazios],
        69634 => [Boss.TheosTentacle, Boss.TheosCrystal, Boss.TheosHead],
        _ => [],
    }
    for boss in currentSceneBosses {
        debug print(`Checking {boss}`)
        // debug print(`currently slain {current.slainBosses[boss]} {Boss.Laspisus}`)
        if settings.enabled(`{boss_settings_name(boss)}`)
            && current.slainBosses[boss] > old.slainBosses[boss]
        {
            debug print(`Slain boss {boss_settings_name(boss)}: {current.slainBosses[boss]}`)
            return match boss {
                Boss.TheosTentacle => current.slainBosses[boss] == 6,
                Boss.LeKyanos | Boss.Magamandra | Boss.Laspisus
                | Boss.Carveros => match current.bossHealth {
                    Some(value) => {
                        debug print(`Health {value}`)
                        value == 0
                    },
                    None => {
                        debug print("Health not found")
                        false
                    },
                },
                _ => current.slainBosses[boss] == 1,
            }
        }
    }
}
