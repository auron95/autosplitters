enum Build {
    PrePatch,
    PostPatch,
}

enum Boss: i8 {
    Byfteriza,
    Clareon,
    Gargantula,
    Laspisus,
    Giasburn,
    Carveros,
    Basileus,
    Brachion,
    Oceanus,
    Ura,
    LeKyanos,
    LeErythros,
    Tentacle,
    TheosHead,
    TheosTentacle,
    TheosCrystal,
    Serpentus,
    Lombrigius,
    Magamandra,
    PirateRevenant,
    Exmetal,
    DoxaGriel,
    Coelacantos,
    Minos,
    Nestor,
    Hydra,
    AvocadoCoast,
    AvocadoGendarme,
    Kiergaard,
    Grazios,
}

fn boss_settings_name(boss: Boss) -> String {
    return match boss {
        Boss.Byfteriza => "byfteriza",
        Boss.Clareon => "clareon",
        Boss.Gargantula => "gargantula",
        Boss.Laspisus => "laspisus",
        Boss.Giasburn => "giasburn",
        Boss.Carveros => "carveros",
        Boss.Basileus => "basileus",
        Boss.Brachion => "brachion",
        Boss.Oceanus => "oceanus",
        Boss.Ura => "ura",
        Boss.LeKyanos => "le_kyanos",
        Boss.LeErythros => "le_erythros",
        Boss.Tentacle => "tentacle",
        Boss.TheosHead => "theos_head",
        Boss.TheosCrystal => "theos_crystal",
        Boss.TheosTentacle => "theos_tentacle",
        Boss.Serpentus => "serpentus",
        Boss.Lombrigius => "lombrigius",
        Boss.Magamandra => "magamandra",
        Boss.PirateRevenant => "pirate_revenant",
        Boss.Exmetal => "exmetal",
        Boss.DoxaGriel => "doxa_griel",
        Boss.Coelacantos => "coelacantos",
        Boss.Minos => "minos",
        Boss.Nestor => "nestor",
        Boss.Hydra => "hydra",
        Boss.AvocadoCoast => "avocado_coast",
        Boss.AvocadoGendarme => "avocado_gendarme",
        Boss.Kiergaard => "kiergaard",
        Boss.Grazios => "grazios",
    }
}

let build: Build
let completedSplits: Map<i32, bool> = Map.new()
struct BossOffset {
    boss: Boss,
    offset: i32,
}

state "ys8.exe" {
    if build == Build.PostPatch || build == Build.PrePatch {
        loadingState: i32 at "ys8.exe", 0x707FC4;
        sceneMain: i32? at "ys8.exe", 0x0708220, 0xAB0;
        sceneBackup: i32 at "ys8.exe", 0x0708220, 0xBA8;
        scene: i32 = {
            match sceneMain {
                Some(0) => sceneBackup,
                Some(scene) => scene,
                None => sceneBackup,
            }
        };
        // bossHealth: f32? at "ys8.exe", 0x705DC4, 0x3B8, 0x8, 0x0, 0x1088;
        bossHealth: f32? at "ys8.exe", 0x6CAC48, 0x1108, 0x9c0, 0x1088;
        journalAddress: address at "ys8.exe", 0x6CAC30;
        slainBosses = {
            let bosses = Map.new<Boss, i8>()
            for { boss, offset } in [
                BossOffset { boss: Boss.Clareon, offset: 0x00 },
                BossOffset { boss: Boss.Gargantula, offset: 0x01 },
                BossOffset { boss: Boss.Laspisus, offset: 0x02 },
                BossOffset { boss: Boss.Giasburn, offset: 0x03 },
                BossOffset { boss: Boss.Carveros, offset: 0x04 },
                BossOffset { boss: Boss.Basileus, offset: 0x05 },
                BossOffset { boss: Boss.Brachion, offset: 0x06 },
                BossOffset { boss: Boss.Oceanus, offset: 0x07 },
                BossOffset { boss: Boss.Ura, offset: 0x08 },
                BossOffset { boss: Boss.LeKyanos, offset: 0x0c },
                BossOffset { boss: Boss.LeErythros, offset: 0x0d },
                BossOffset { boss: Boss.Tentacle, offset: 0x0e },
                BossOffset { boss: Boss.TheosHead, offset: 0x10 },
                BossOffset { boss: Boss.TheosTentacle, offset: 0x12 },
                BossOffset { boss: Boss.TheosCrystal, offset: 0x13 },
                BossOffset { boss: Boss.Serpentus, offset: 0x15 },
                BossOffset { boss: Boss.Lombrigius, offset: 0x17 },
                BossOffset { boss: Boss.Magamandra, offset: 0x18 },
                BossOffset { boss: Boss.PirateRevenant, offset: 0x19 },
                BossOffset { boss: Boss.Exmetal, offset: 0x1a },
                BossOffset { boss: Boss.DoxaGriel, offset: 0x1b },
                BossOffset { boss: Boss.Coelacantos, offset: 0x1c },
                BossOffset { boss: Boss.Minos, offset: 0x1d },
                BossOffset { boss: Boss.Nestor, offset: 0x1e },
                BossOffset { boss: Boss.Hydra, offset: 0x1f },
                BossOffset { boss: Boss.AvocadoCoast, offset: 0x20 },
                BossOffset { boss: Boss.AvocadoGendarme, offset: 0x22 },
                BossOffset { boss: Boss.Kiergaard, offset: 0x25 },
                BossOffset { boss: Boss.Grazios, offset: 0x28 },
            ] {
                bosses[boss] = process.read<i8>(journalAddress.offset(0x22C50 + offset))?
            }
            bosses[Boss.Byfteriza] = byfteriza
            bosses
        };
        byfteriza: i8 at "ys8.exe", 0x6CAC30, 0x22B9E;
    }
}

